# Provedor ativo: openai ou gemini
AI_PROVIDER=openai

# Preencha somente a chave do provedor selecionado. Nunca versione chaves reais.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Configuração compartilhada por ingestão e busca
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PDF_PATH=document.pdf
COLLECTION_NAME=document_pdf

# O vazio aplica os defaults do provedor:
# OpenAI: text-embedding-3-small / gpt-5-nano
# Gemini: models/embedding-001 / gemini-2.5-flash-lite
EMBEDDING_MODEL=
LLM_MODEL=
